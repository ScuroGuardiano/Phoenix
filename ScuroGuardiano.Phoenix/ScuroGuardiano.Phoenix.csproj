<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <TargetFramework>net8.0</TargetFramework>
        <PackageId>ScuroGuardiano.Phoenix</PackageId>
        <Version>1.0.0</Version>
        <Authors>ScuroGuardiano</Authors>
        <Description>Thin wrapper on execve on Unix-like systems and prctl on Linux</Description>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>

        <PackageReadmeFile>../README.md</PackageReadmeFile>
        <PackageTags>execve;linux;unix;process;native</PackageTags>

        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    </PropertyGroup>

    <ItemGroup>
        <None Include="../README.md"
              Pack="true"
              PackagePath="\" />
    </ItemGroup>
</Project>